generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  ADMIN
}

enum TransactionType {
  EXPENSE
  INCOME
}

enum TransactionSource {
  MANUAL
  AI_TEXT
  AI_RECEIPT
}

enum AiFeature {
  PARSE_TEXT
  PARSE_RECEIPT
  ASK
}

enum AiStatus {
  SUCCESS
  INVALID_OUTPUT
  ERROR
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  name         String
  role         Role     @default(USER)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  accounts      Account[]
  categories    Category[]
  transactions  Transaction[]
  refreshTokens RefreshToken[]
  aiUsage       AiUsage[]
}

model RefreshToken {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Account {
  id                  String   @id @default(uuid())
  userId              String
  name                String
  currency            String   @default("EUR")
  openingBalanceCents Int      @default(0)
  isDefault           Boolean  @default(false)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions Transaction[]

  @@unique([userId, name])
}

model Category {
  id         String          @id @default(uuid())
  userId     String
  name       String
  type       TransactionType
  color      String?
  icon       String?
  archivedAt DateTime?
  createdAt  DateTime        @default(now())

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions Transaction[]

  @@unique([userId, type, name])
}

model Transaction {
  id          String            @id @default(uuid())
  userId      String
  accountId   String
  categoryId  String
  type        TransactionType
  amountCents Int
  description String
  merchant    String?
  date        DateTime          @db.Date
  source      TransactionSource @default(MANUAL)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  account  Account  @relation(fields: [accountId], references: [id], onDelete: NoAction)
  category Category @relation(fields: [categoryId], references: [id], onDelete: NoAction)

  @@index([userId, date])
  @@index([userId, type, date])
  @@index([userId, categoryId, date])
}

model AiUsage {
  id           String    @id @default(uuid())
  userId       String
  feature      AiFeature
  model        String
  inputTokens  Int
  outputTokens Int
  status       AiStatus
  latencyMs    Int
  createdAt    DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}